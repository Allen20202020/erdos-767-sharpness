JSP628.threshold_sharpness (k : ℕ) (hk : 2 ≤ k) :
  ∃ G, ¬JSP628.HasCycleWithKIncidentChords k G ∧ G.edgeSet.ncard = (k + 1) * (JSP628.criticalOrder k - k - 1) + 1
